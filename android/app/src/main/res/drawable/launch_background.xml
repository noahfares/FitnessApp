<?xml version="1.0" encoding="utf-8"?>
<!-- The window behind the app while the Flutter engine starts (`F-THM-006`).
     Brand colour plus the mark, so launch reads as this app starting rather
     than as a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/ic_launcher_foreground" />
    </item>
</layer-list>
