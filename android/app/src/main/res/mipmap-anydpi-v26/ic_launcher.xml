<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (`F-THM-006`): the launcher masks this to whatever shape the
     device uses, so the glyph sits inside the 66% safe zone and the background
     is a flat colour rather than artwork that would be cropped unpredictably. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@drawable/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_foreground"/>
</adaptive-icon>
